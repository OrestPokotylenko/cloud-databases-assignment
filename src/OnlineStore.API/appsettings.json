{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Queues": {
    "CreateOrderQueueName": "order-create",
    "OrderUpdateQueueName": "order-update"
  },
  "ProductImages": {
    "ContainerName": "product-images",
    "UploadUrlLifetimeMinutes": 10,
    "MaximumSizeBytes": 10485760,
    "SupportedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ]
  },
  "ProductReviews": {
    "TableName": "productreviews"
  },
  "AllowedHosts": "*"
}
